{
  "name": "excel-mcp-intro",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "hyperframes preview",
    "check": "hyperframes check",
    "render": "npm run render:quality",
    "render:quality": "hyperframes render --quality=high --crf=18 --resolution=landscape-4k --format=mp4 --output renders/excel-mcp-intro-4k.mp4",
    "render:draft": "hyperframes render --quality=draft --resolution=landscape --format=mp4 --output renders/excel-mcp-intro-draft.mp4",
    "publish": "hyperframes publish"
  },
  "devDependencies": {
    "hyperframes": "0.8.214"
  }
}
