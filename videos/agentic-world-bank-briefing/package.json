{
  "name": "agentic-world-bank-briefing",
  "private": true,
  "type": "module",
  "scripts": {
    "footage": "node prepare-footage.mjs",
    "slides": "node prepare-slides.mjs",
    "build": "node build.mjs",
    "dev": "hyperframes preview",
    "check": "hyperframes check",
    "render": "npm run render:quality",
    "render:quality": "hyperframes render --quality=high --crf=18 --resolution=landscape-4k --format=mp4 --output renders/agentic-world-bank-briefing-4k.mp4",
    "render:draft": "hyperframes render --quality=draft --resolution=landscape --format=mp4 --output renders/agentic-world-bank-briefing-draft.mp4",
    "publish": "hyperframes publish"
  },
  "devDependencies": {
    "hyperframes": "0.8.184"
  }
}
